{
  "name": "tang-song-poet-map",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "唐宋诗人词人时空轨迹地图 —— 人 · 时间 · 地点 · 作品 一一对应",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/check-entry.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:entry": "node scripts/check-entry.mjs",
    "check:data": "esbuild scripts/data-check.ts --bundle --platform=node --outfile=.data-check.cjs --log-level=error && node .data-check.cjs",
    "verify": "npm run check:entry && npm run typecheck && npm run check:data && vite build"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.0",
    "@types/geojson": "^7946.0.14",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
